---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { EJES } from '../content.config';

const recursos = await getCollection('recursos');
const destacados = recursos.filter((r) => r.data.destacado).slice(0, 6);
const cuenta = (f: (r: (typeof recursos)[number]) => boolean) => recursos.filter(f).length;
const puertas = [
  {
    rotulo: '01 · Estudiantes',
    titulo: 'Aprende a usar la IA y a desconfiar de ella',
    texto: 'Cursos, lecciones y juegos para estudiar, investigar y revisar un escrito con IA, y detectar cuándo se equivoca.',
    href: '/recursos/?publico=estudiantes',
    n: cuenta((r) => r.data.publico.includes('estudiantes')),
  },
  {
    rotulo: '02 · Docentes',
    titulo: 'Llévala a tu clase',
    texto: 'Guías, guiones de clase y paquetes para el aula virtual, listos para adaptar.',
    href: '/docentes/',
    n: cuenta((r) => r.data.publico.includes('docentes')),
  },
  {
    rotulo: '03 · Construir',
    titulo: 'Crea tus propias herramientas',
    texto: 'Prompts, plantillas y tutoriales para pasar del chat a un flujo de trabajo propio y publicado.',
    href: '/recursos/?eje=construir',
    n: cuenta((r) => r.data.ejes.includes('construir')),
  },
];
---
<Base titulo="Inicio">
  <section class="portada contenedor">
    <p class="rotulo">Repositorio abierto · IA y Derecho</p>
    <h1>Recursos para aprender y enseñar inteligencia artificial en Derecho</h1>
    <p class="bajada">
      Todo lo que EVA ha creado para clases de Derecho, en un solo lugar: cursos, lecciones, juegos, guías y prompts.
      Cada recurso tiene una ficha con su público, sus objetivos, su licencia y dónde usarlo.
    </p>
    <div class="acciones">
      <a class="boton" href="/recursos/">Ver los {recursos.length} recursos</a>
      <a class="boton secundario" href="/contribuir/">Proponer un recurso</a>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <p class="rotulo">Elige tu entrada</p>
      <div class="puertas">
        {puertas.map((p) => (
          <a class="puerta" href={p.href}>
            <span class="rotulo">{p.rotulo}</span>
            <h2>{p.titulo}</h2>
            <p>{p.texto}</p>
            <span class="pie-puerta">{p.n} recursos <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {destacados.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <p class="rotulo">Para empezar</p>
        <h2>Recursos destacados</h2>
        <div class="rejilla">{destacados.map((r) => <Tarjeta recurso={r} />)}</div>
      </div>
    </section>
  )}

  <section class="seccion">
    <div class="contenedor">
      <p class="rotulo">Ejes</p>
      <h2>Seis ejes, de entender la IA a construir con ella</h2>
      <ol class="ejes">
        {Object.entries(EJES).map(([clave, nombre], i) => (
          <li>
            <a href={`/recursos/?eje=${clave}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span>{nombre}</span>
              <span class="n">{cuenta((r) => r.data.ejes.includes(clave as keyof typeof EJES))}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos">
      <div>
        <p class="rotulo">Cómo funciona</p>
        <h2>Abierto, revisado y con fuentes</h2>
      </div>
      <ul class="pasos">
        <li><strong>Ficha estándar.</strong> Cada recurso declara público, objetivos, licencia y estado, con metadatos LRMI que leen los buscadores.</li>
        <li><strong>Revisión.</strong> Un recurso pasa de borrador a publicado cuando alguien del equipo revisa su contenido jurídico y sus fuentes.</li>
        <li><strong>Reutilizable.</strong> Se puede adaptar y llevar a Moodle o Canvas, respetando la licencia de cada recurso.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .portada { padding-block: clamp(56px, 10vw, 120px) clamp(40px, 6vw, 72px); }
  .portada h1 { max-width: 18ch; }
  .bajada { font-size: 1.2rem; color: var(--suave); max-width: 60ch; }
  .acciones { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .puertas { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
  .puerta {
    display: flex; flex-direction: column; gap: 10px; padding: 28px;
    border: 1.5px solid var(--filete-fuerte); background: var(--fondo); text-decoration: none;
    transition: background 0.15s;
  }
  .puerta:hover { background: var(--acento-suave); color: var(--texto); }
  .puerta h2 { font-size: 1.5rem; margin: 0; }
  .puerta p { color: var(--suave); margin: 0; flex: 1; }
  .pie-puerta { font: 500 0.85rem var(--mono); }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 16px; margin-top: 24px; }
  .ejes { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); column-gap: 32px; }
  .ejes a { display: grid; grid-template-columns: 48px 1fr auto; align-items: center; padding: 16px 4px; border-bottom: 1px solid var(--filete); text-decoration: none; font-weight: 600; }
  .ejes .num, .ejes .n { font: 500 0.8rem var(--mono); color: var(--tenue); }
  .dos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 32px; }
  .pasos { margin: 0; padding-left: 1.2em; display: grid; gap: 12px; color: var(--suave); }
  .pasos strong { color: var(--texto); }
</style>
