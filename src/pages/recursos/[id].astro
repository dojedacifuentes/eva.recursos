---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TIPOS, EJES, ESTADOS } from '../../content.config';

export async function getStaticPaths() {
  const recursos = await getCollection('recursos');
  return recursos.map((recurso) => ({ params: { id: recurso.id }, props: { recurso } }));
}
const { recurso } = Astro.props;
const d = recurso.data;
const { Content } = await render(recurso);
const fecha = d.actualizado.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Metadatos LRMI / schema.org para buscadores y otros repositorios
const jsonld = {
  '@context': 'https://schema.org',
  '@type': d.tipo === 'curso' ? ['Course', 'LearningResource'] : 'LearningResource',
  name: d.titulo,
  description: d.resumen,
  inLanguage: 'es',
  learningResourceType: TIPOS[d.tipo],
  educationalLevel: d.nivel,
  audience: d.publico.map((p) => ({ '@type': 'EducationalAudience', educationalRole: p === 'docentes' ? 'teacher' : 'student' })),
  about: d.ejes.map((e) => EJES[e]),
  teaches: d.objetivos,
  keywords: d.etiquetas.join(', '),
  timeRequired: d.duracion,
  license: d.licencia,
  author: d.autoria.map((name) => ({ '@type': 'Person', name })),
  dateModified: d.actualizado.toISOString().slice(0, 10),
  url: d.enlace,
  isAccessibleForFree: true,
};
---
<Base titulo={d.titulo} descripcion={d.resumen} jsonld={jsonld}>
  <article class="contenedor ficha">
    <a class="volver rotulo" href="/recursos/">← Todos los recursos</a>
    <p class="rotulo">{TIPOS[d.tipo]} · {d.proyecto}</p>
    <h1 data-pagefind-meta="title">{d.titulo}</h1>
    <p class="bajada">{d.resumen}</p>

    <div class="cuerpo">
      <div class="prosa">
        {d.avisos.length > 0 && (
          <aside class="avisos" data-pagefind-ignore>
            <p class="rotulo">Antes de usarlo</p>
            <ul>{d.avisos.map((a) => <li>{a}</li>)}</ul>
          </aside>
        )}
        {d.objetivos.length > 0 && (
          <>
            <h2>Qué se aprende</h2>
            <ul>{d.objetivos.map((o) => <li>{o}</li>)}</ul>
          </>
        )}
        <Content />
      </div>

      <aside class="datos" data-pagefind-ignore>
        {d.enlace ? (
          <a class="boton" href={d.enlace} target="_blank" rel="noopener">Abrir el recurso ↗</a>
        ) : (
          <p class="sin-enlace">Todavía no tiene una dirección pública.</p>
        )}
        <dl>
          <dt>Estado</dt><dd><span class={`chip estado-${d.estado}`}>{ESTADOS[d.estado]}</span></dd>
          <dt>Público</dt><dd>{d.publico.map((p) => (p === 'docentes' ? 'Docentes' : 'Estudiantes')).join(' y ')}</dd>
          <dt>Ejes</dt><dd>{d.ejes.map((e) => EJES[e]).join(' · ')}</dd>
          <dt>Nivel</dt><dd class="cap">{d.nivel}</dd>
          {d.duracion && <><dt>Duración</dt><dd>{d.duracion}</dd></>}
          {d.formato.length > 0 && <><dt>Formato</dt><dd>{d.formato.join(', ')}</dd></>}
          <dt>Licencia</dt><dd>{d.licencia}</dd>
          <dt>Autoría</dt><dd>{d.autoria.join(', ')}</dd>
          {d.fuente && <><dt>Original</dt><dd><code>{d.fuente}</code></dd></>}
          <dt>Actualizado</dt><dd>{fecha}</dd>
        </dl>
        {d.etiquetas.length > 0 && <div class="chips">{d.etiquetas.map((e) => <span class="chip">{e}</span>)}</div>}
      </aside>
    </div>
  </article>
</Base>

<style>
  .ficha { padding-block: 40px 96px; }
  .volver { display: inline-block; margin-bottom: 24px; text-decoration: none; }
  .ficha h1 { max-width: 22ch; }
  .bajada { font-size: 1.2rem; color: var(--suave); max-width: 60ch; }
  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px; margin-top: 32px; align-items: start; }
  .datos { position: sticky; top: 88px; padding: 20px; border: 1.5px solid var(--filete-fuerte); background: var(--fondo); display: grid; gap: 16px; }
  .datos .boton { justify-content: center; }
  .sin-enlace { margin: 0; color: var(--tenue); font-size: 0.9rem; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 8px 12px; font-size: 0.92rem; }
  dt { font: 500 0.72rem/1.9 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--tenue); }
  dd { margin: 0; }
  dd code { font: 0.78rem var(--mono); word-break: break-all; color: var(--suave); }
  .cap { text-transform: capitalize; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .avisos { border-left: 3px solid var(--ambar); padding: 12px 16px; background: var(--superficie); margin-bottom: 24px; }
  .avisos ul { margin: 6px 0 0; }
  @media (max-width: 860px) {
    .cuerpo { grid-template-columns: 1fr; }
    .datos { position: static; order: -1; }
  }
</style>
