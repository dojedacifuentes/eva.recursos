---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
  jsonld?: object;
}
const { titulo, descripcion = 'Recursos abiertos para aprender y enseñar inteligencia artificial en Derecho.', jsonld } = Astro.props;
const ruta = Astro.url.pathname;
const menu = [
  ['/recursos/', 'Recursos'],
  ['/docentes/', 'Para docentes'],
  ['/contribuir/', 'Contribuir'],
  ['/acerca/', 'Acerca'],
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo === 'Inicio' ? 'EVA · Recursos de IA y Derecho' : `${titulo} · EVA Recursos`}</title>
    <meta name="description" content={descripcion} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor fila">
        <a href="/" class="marca" aria-label="Inicio">
          <span class="isotipo" aria-hidden="true">EVA</span>
          <span class="nombre">Recursos<br /><small>IA y Derecho</small></span>
        </a>
        <nav aria-label="Principal">
          {menu.map(([href, txt]) => (
            <a href={href} aria-current={ruta.startsWith(href) ? 'page' : undefined}>{txt}</a>
          ))}
        </nav>
      </div>
    </header>
    <main data-pagefind-body={ruta.startsWith('/recursos/') && ruta !== '/recursos/' ? '' : undefined}>
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor fila">
        <p>Repositorio abierto de EVA para docentes y estudiantes de Derecho. Contenido <a href="https://creativecommons.org/licenses/by/4.0/deed.es">CC BY 4.0</a> · código MIT.</p>
        <p class="rotulo">Hecho en Valparaíso · {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--fondo) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--filete);
  }
  .fila { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .cabecera .fila { min-height: 64px; }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .isotipo {
    display: grid; place-items: center; width: 40px; height: 40px;
    border: 1.5px solid var(--filete-fuerte); font: 700 0.8rem/1 var(--mono); letter-spacing: 0.06em;
  }
  .nombre { font-weight: 700; line-height: 1.05; }
  .nombre small { font: 500 0.68rem var(--mono); color: var(--tenue); letter-spacing: 0.06em; text-transform: uppercase; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a { padding: 8px 10px; text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--suave); }
  nav a[aria-current='page'] { color: var(--texto); box-shadow: inset 0 -2px 0 var(--filete-fuerte); }
  .pie { border-top: 1px solid var(--filete); padding-block: 32px; color: var(--tenue); font-size: 0.9rem; }
  .pie p { margin: 0; }
  @media (max-width: 640px) {
    .cabecera .fila { padding-block: 8px; }
    nav { width: 100%; justify-content: space-between; }
    nav a { padding: 6px 4px; font-size: 0.88rem; }
  }
</style>
